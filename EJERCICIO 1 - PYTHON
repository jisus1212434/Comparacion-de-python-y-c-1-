# Lista de alumnos usando una clase

class Alumno:
    def _init_(self, nombre, calificacion):
        self.nombre = nombre
        self.calificacion = calificacion

    def aprobado(self):
        return self.calificacion >= 6

# Creación de la lista de alumnos
alumnos = [
    Alumno("Ana", 9),
    Alumno("Luis", 5),
    Alumno("Sofia", 8)
]

# Recorrido e impresión
for alumno in alumnos:
    print(alumno.nombre, alumno.calificacion)
    if alumno.aprobado():
        print("Aprobado")
    else:
        print("Reprobado")
